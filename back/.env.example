PORT=3000

# MySQL — mesmo banco do projeto telemedicina (iClinica)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# OpenAI — forma tradicional (prioridade sobre /admin)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Integração iClinica (sync de sessões e catálogo de jornadas)
# Local: http://localhost
# Produção: https://crescere.life
ICLINICA_API_URL=
LIA_SYNC_SECRET=

# Tenant padrão (slug em companies.slug)
DEFAULT_TENANT_SLUG=crescere
DEFAULT_TENANT_NAME=Crescere

# Integração iClinica (telemedicina) — jornadas, prompt MEDA-LIA e sync de sessões
ICLINICA_API_URL=http://localhost:8080
LIA_SYNC_SECRET=

# Painel /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha-forte
