# Copie para a raiz do projeto na instância AWS:
#   cp deploy/.env.production.example .env.production
#
# DNS (registro A):
#   lia.crescere.life  →  18.191.145.116
DOMAIN=lia.crescere.life

# MySQL compartilhado (RDS) — telemedicina + LIA
# Veja: deploy/RDS-MIGRATION.md
DB_HOST=crescere-shared.xxxxx.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=crescere_shared
DB_USERNAME=crescere_app
DB_PASSWORD=TROQUE_SENHA_FORTE_DB

# Legado (MySQL no Docker do telemedicina via túnel SSH na EC2 LIA):
# DB_HOST=host.docker.internal
# DB_PORT=3307

# OpenAI — prioridade sobre credenciais do /admin
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Integração iClinica — mesmo valor de LIA_SYNC_SECRET no telemedicina
ICLINICA_API_URL=https://crescere.life
LIA_SYNC_SECRET=TROQUE_MESMO_SEGREDO_DO_TELEMEDICINA

DEFAULT_TENANT_SLUG=crescere
DEFAULT_TENANT_NAME=Crescere

# Painel /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TROQUE_SENHA_ADMIN_FORTE
